{
  "manifest_version": 3,
  "name": "GeoHistory - Traceur d'accès Géolocalisation",
  "version": "1.0.0",
  "description": "Journalise en temps réel chaque requête d'accès à votre géolocalisation effectuée par les sites web et composants du navigateur.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["injected.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "world": "ISOLATED",
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "GeoHistory - Journal de géolocalisation"
  }
}
